{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "noImplicitAny": false
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
