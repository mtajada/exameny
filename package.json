{
  "name": "exameny",
  "version": "0.1.0",
  "private": false,
  "license": "AGPL-3.0-or-later",
  "description": "Open source English practice, feedback, and learning workflows for learners, teachers, and academies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtajada/exameny.git"
  },
  "homepage": "https://github.com/mtajada/exameny#readme",
  "bugs": {
    "url": "https://github.com/mtajada/exameny/issues"
  },
  "keywords": [
    "education",
    "english-learning",
    "openai",
    "responses-api",
    "supabase"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test tests/e2e/public-demo.spec.ts",
    "content:check": "npm --prefix content/cleanroom run check",
    "eval:luna:verify": "npm --prefix evals/luna run verify",
    "smoke:openai-adapter": "deno run --no-config --allow-env=OPENAI_API_KEY --allow-net=api.openai.com scripts/smoke-openai-responses.ts",
    "db:check": "npm run db:check:static && npm run db:test",
    "db:check:static": "node scripts/database-static-check.mjs",
    "db:test": "node scripts/database-test.mjs",
    "db:types": "node scripts/regenerate-database-types.mjs",
    "db:types:check": "node scripts/check-database-types.mjs",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "supabase:lint": "supabase db lint --local",
    "supabase:stop": "supabase stop",
    "edge:fmt:check": "deno fmt --check supabase/functions",
    "edge:lint": "deno lint supabase/functions",
    "edge:check": "deno check --config=deno.json supabase/functions",
    "edge:test": "deno test --config=deno.json --allow-read=supabase/functions --allow-write=supabase/functions/tests --allow-env=AI_TIMEOUT_MS,ALLOWED_ORIGINS,APP_ENV,EMAIL_PROVIDER_BACKOFF_MS,EMAIL_PROVIDER_MAX_ATTEMPTS,EXAMENY_SUPABASE_PUBLISHABLE_KEY,EXAMENY_SUPABASE_SECRET_KEY,LOG_ALIAS_CONFLICT_TOKEN,LOG_STREAM,LOG_TOKENS,MEMBERSHIP_CLEANUP_SECRET,RATE_LIMIT_ALLOW_IN_MEMORY_FALLBACK,RESEND_API_KEY,RESEND_API_URL,RESEND_FROM_EMAIL,RUOE_GENERATION_LIMIT_IP_WINDOW_MS,RUOE_GENERATION_LIMIT_PER_IP,RUOE_GENERATION_LIMIT_PER_USER,RUOE_GENERATION_LIMIT_USER_WINDOW_MS,SITE_URL,SUPABASE_PROJECT_REF,SUPABASE_URL,SUPER_ADMIN_INVITE_LIMIT_PER_IP,SUPER_ADMIN_INVITE_LIMIT_PER_USER,SUPER_ADMIN_INVITE_LIMIT_USER_WINDOW_MS,SUPER_ADMIN_INVITE_LIMIT_WINDOW_MS,SUPER_ADMIN_SIGNATURE_WINDOW_MS,UPSTASH_REDIS_REST_TOKEN,UPSTASH_REDIS_REST_URL,VITE_AUTH_GOOGLE_ENABLED,VITE_AUTH_MAGIC_LINK_ENABLED,VITE_AUTH_MICROSOFT_ENABLED supabase/functions",
    "validate:env": "node scripts/validate-env.cjs --mode=development --file=.env.example --allow-placeholders",
    "validate:env:production": "node scripts/validate-env.cjs --mode=production",
    "privacy:logs": "node --test scripts/check-log-privacy.test.mjs && node scripts/check-log-privacy.mjs",
    "security:secrets": "secretlint \"**/*\"",
    "licenses:check": "license-checker-rseidelsohn --production --onlyAllow '0BSD;AGPL-3.0-or-later;Apache-2.0;BSD-2-Clause;BSD-3-Clause;CC0-1.0;ISC;MIT;MPL-2.0;Python-2.0;Unlicense'",
    "sbom": "cyclonedx-npm --output-file evidence/sbom.cdx.json",
    "package:check": "node scripts/package-check.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.56.2",
    "@tiptap/extension-blockquote": "^2.2.4",
    "@tiptap/extension-bold": "^2.2.4",
    "@tiptap/extension-bullet-list": "^2.2.4",
    "@tiptap/extension-code": "^2.2.4",
    "@tiptap/extension-heading": "^2.2.4",
    "@tiptap/extension-italic": "^2.2.4",
    "@tiptap/extension-link": "^2.2.4",
    "@tiptap/extension-ordered-list": "^2.2.4",
    "@tiptap/extension-strike": "^2.2.4",
    "@tiptap/extension-underline": "^2.2.4",
    "@tiptap/pm": "^2.2.4",
    "@tiptap/react": "^2.2.4",
    "@tiptap/starter-kit": "^2.2.4",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.3.0",
    "input-otp": "^1.2.4",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.53.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "vaul": "^0.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@electric-sql/pglite": "^0.3.11",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "deno": "2.9.5",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^24.1.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "postcss": "^8.4.47",
    "secretlint": "^13.0.4",
    "supabase": "2.115.0",
    "tailwindcss": "^3.4.11",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "packageManager": "npm@11.16.0"
}
