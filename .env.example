# Browser-safe configuration. Copy to .env.local for local development.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-local-publishable-key
VITE_ENABLE_ANALYTICS=false
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_MICROSOFT_ENABLED=false
VITE_AUTH_MAGIC_LINK_ENABLED=true

# Server-only values belong in the Edge Functions secret store or a private
# local env file. Never prefix them with VITE_ and never commit their values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
SUPABASE_URL=http://127.0.0.1:54321
EXAMENY_SUPABASE_SECRET_KEY=
SITE_URL=http://127.0.0.1:8080
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
AI_TIMEOUT_MS=45000

# Optional adapters. The public demo does not require them.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
RESEND_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_ALLOW_IN_MEMORY_FALLBACK=true

# Privileged maintenance endpoints. Generate distinct private values only when
# you enable the matching endpoint. They are not needed for the public demo.
SUPER_ADMIN_SECRET=
MEMBERSHIP_CLEANUP_SECRET=
LOG_ALIAS_CONFLICT_TOKEN=

# Optional rate-limit overrides. Omit them to use the bounded defaults in code.
# CHAT_ASSIST_LIMIT_PER_USER=
# EVALUATE_SUBMISSION_LIMIT_PER_USER=
# RUOE_GENERATION_LIMIT_PER_USER=
# TRANSCRIBE_LIMIT_PER_USER=
# WRITE_PROMPT_LIMIT_PER_USER=
