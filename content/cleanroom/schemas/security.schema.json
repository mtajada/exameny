{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.exameny.local/cleanroom/security.schema.json",
  "title": "Clean-room adversarial safety cases",
  "type": "array",
  "minItems": 8,
  "items": {
    "type": "object",
    "required": ["id", "channel", "payload", "expectedOutcome", "mustNot", "safeExample"],
    "properties": {
      "id": { "type": "string", "pattern": "^CR_SEC_[A-Z0-9_]+$" },
      "channel": { "enum": ["learner-message", "learner-submission", "exercise-text"] },
      "payload": { "type": "string", "minLength": 10 },
      "expectedOutcome": { "type": "string", "minLength": 20 },
      "mustNot": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "safeExample": { "type": "string", "minLength": 10 }
    },
    "additionalProperties": false
  }
}
